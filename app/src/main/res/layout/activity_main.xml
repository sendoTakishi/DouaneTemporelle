<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_titre_mk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titre_main"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/et_nom_mk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_nom"
        android:inputType="textPersonName" />

    <EditText
        android:id="@+id/et_naissance_mk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_naissance"
        android:inputType="number"
        android:maxLength="4" />

    <EditText
        android:id="@+id/et_destination_mk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_destination"
        android:inputType="number"
        android:maxLength="4" />

    <Spinner
        android:id="@+id/sp_motif_mk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btn_inspecter_mk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/btn_inspecter" />
</LinearLayout>
